# ==========================================
# ATELIER DU CAFÉ - PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================

# 1. SERVER & DATABASE CONFIGURATION
NODE_ENV=production
PORT=4000
DATABASE_URL="postgresql://atelier_admin:YourSecurePassword@db.your-host.supabase.co:5432/postgres"
REDIS_URL="redis://default:YourRedisPassword@redis-host.com:6379"
JWT_SECRET="generate-a-long-random-secret-key-for-jwt-signing-2026"
JWT_EXPIRES_IN="7d"

# 2. DOMAINS & CLIENT URLS
NEXT_PUBLIC_API_URL="https://api.yourdomain.com/api/v1"
NEXT_PUBLIC_STORE_URL="https://yourdomain.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.yourdomain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# 3. META WHATSAPP BUSINESS CLOUD API (Official WhatsApp API)
WHATSAPP_PROVIDER="meta"
WHATSAPP_PHONE_NUMBER_ID="108xxxxxxxxxxxx"
WHATSAPP_BUSINESS_ACCOUNT_ID="109xxxxxxxxxxxx"
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_VERIFY_TOKEN="atelier-du-cafe-verify-token-2026"

# 4. PAYMENT GATEWAY (Midtrans Snap & Xendit)
PAYMENT_PROVIDER="midtrans"
MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=true

# (Optional: Xendit Alternative)
XENDIT_SECRET_KEY="xnd_production_xxxxxxxxxxxx"
XENDIT_PUBLIC_KEY="xnd_public_xxxxxxxxxxxx"